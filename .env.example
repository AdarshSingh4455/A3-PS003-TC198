# TrafficPulse-X Backend Environment Configuration
# Copy this file to .env and configure your environment variables.
# Do NOT commit .env with real credentials to source control.

# Optional: Google Gemini API Key for TrafficPulse-X Live AI Assistant
# If left empty, TrafficPulse-X Assistant automatically uses its domain knowledge engine.
GEMINI_API_KEY=

# Backend Host & Port
HOST=127.0.0.1
PORT=8000
